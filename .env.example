# Settings of compose.yaml. Copy this file to .env and edit it. The README
# lists all settings.

# Domain of the server. Its DNS must point to this machine, and ports 80
# and 443 must be open, so that Caddy can get a certificate.
SBM_DOMAIN=sbm.example.org

# Optional: email address on the privacy page.
#SBM_CONTACT=you@example.org

# Optional: new accounts confirm their email address. Needs an SMTP server.
#SBM_SMTP_HOST=smtp.example.org
#SBM_SMTP_PORT=587
#SBM_SMTP_USER=sbm@example.org
#SBM_SMTP_PASSWORD=
#SBM_MAIL_FROM=sbm Sync <sbm@example.org>
